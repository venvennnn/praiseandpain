# Public (exposed to the browser)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — REQUIRED for the live product (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED — primary feedback collection (Google Maps, App Store, Play, YouTube)
SERPAPI_API_KEY=your-serpapi-key

# REQUIRED — real Jev classification (no invented labels)
TYPESAFE_API_KEY=your-typesafe-jev-key
TYPESAFE_MODEL=jev-latest

# REQUIRED — durable collection / classify / aggregate pipeline
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# Optional generative model for emerging topic proposals only
GENERATIVE_API_KEY=
GENERATIVE_API_URL=

# Budget defaults (also configurable per workspace in DB)
DEFAULT_RETRIEVAL_BUDGET=200
DEFAULT_USAGE_LIMIT=2000
